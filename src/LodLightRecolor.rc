// FiveM's asi-five loader (code/components/asi-five/src/Component.cpp)
// refuses any .asi on game build >= 2189 unless it carries a resource named
// FX_ASI_BUILD whose *type* is the numeric game build:
//
//   FindResource(hModule, L"FX_ASI_BUILD", MAKEINTRESOURCE(gameBuild))
//
// One line per build. Claiming a build is safe for this plugin: it only
// hooks when Cfx's byte pattern matches exactly once, otherwise it logs
// "inactive". Keep this list in step with the CitizenFX_SubProcess_game_*
// files in FiveM.app when new builds appear.
FX_ASI_BUILD 2189 BEGIN "\0" END
FX_ASI_BUILD 2372 BEGIN "\0" END
FX_ASI_BUILD 2545 BEGIN "\0" END
FX_ASI_BUILD 2612 BEGIN "\0" END
FX_ASI_BUILD 2699 BEGIN "\0" END
FX_ASI_BUILD 2802 BEGIN "\0" END
FX_ASI_BUILD 2944 BEGIN "\0" END
FX_ASI_BUILD 3095 BEGIN "\0" END
FX_ASI_BUILD 3258 BEGIN "\0" END
FX_ASI_BUILD 3323 BEGIN "\0" END
FX_ASI_BUILD 3407 BEGIN "\0" END
FX_ASI_BUILD 3570 BEGIN "\0" END
FX_ASI_BUILD 3751 BEGIN "\0" END
FX_ASI_BUILD 3788 BEGIN "\0" END
FX_ASI_BUILD 3889 BEGIN "\0" END
